# Supabase の接続情報
# ローカル開発では `supabase start` の出力に表示される値を使う。
# 本番では Supabase ダッシュボードの Project Settings > API から取得する。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側でのみ使う鍵。RLS を迂回するので、クライアントに渡してはいけない。
# NEXT_PUBLIC_ を付けないこと。
#
# 公開サインアップを止めているため、アカウントの作成にこの鍵が必要になる。
# アプリは招待を検証したうえで、この鍵で管理APIを呼んでユーザーを作る。
SUPABASE_SERVICE_ROLE_KEY=
