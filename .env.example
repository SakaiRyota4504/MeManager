# Supabase の接続情報。必要なのはこの3つだけ。
#
# Supabase の画面 → Project Settings → API Keys で確認する。
# 鍵の名前は、プロジェクトを作った時期によって2通りある。どちらでも動く。
#
#   新しい表記              古い表記（従来）
#   Publishable key   ←→   anon public
#   Secret key        ←→   service_role
#
# ---------------------------------------------------------------------------

# プロジェクトのURL（Project Settings → API の Project URL）
NEXT_PUBLIC_SUPABASE_URL=

# ブラウザに配られる鍵。公開されて構わない。
# 行の読み書きは RLS が制限する。
#   Publishable key（sb_publishable_... ）または anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側でのみ使う鍵。RLS を迂回し、すべてのデータを操作できる。
#   Secret key（sb_secret_... ）または service_role
#
# 絶対に人に見せない。NEXT_PUBLIC_ を付けない（付けるとブラウザに配られる）。
# 公開サインアップを止めているため、アカウントの作成にこの鍵が必要になる。
SUPABASE_SERVICE_ROLE_KEY=
